# Copy to .env.vps and fill in. Do NOT commit .env.vps.
# Generate secrets with: openssl rand -base64 48   (DB key: openssl rand -base64 128)

# Public origin users and the desktop app reach. Switch to https://your-domain later.
PUBLIC_ORIGIN=http://103.228.38.69

MYSQL_ROOT_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me-32-plus-characters
DEN_DB_ENCRYPTION_KEY=change-me-32-plus-characters

# Singleton org: who can claim ownership, and a one-time /setup code for the first admin.
DEN_SINGLE_ORG_OWNER_EMAILS=you@example.com
DEN_INITIAL_ADMIN_BOOTSTRAP_CODE=change-me-one-time-code
DEN_SINGLE_ORG_ALLOW_PUBLIC_SIGNUP=false

# Leave 0 on a public server. Set 1 only if sign-in over plain http misbehaves while testing.
UNICLI_DEV_MODE=0
